# Network Configuration
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.network

# Deployment (NEVER commit this file with real keys!)
PRIVATE_KEY=0x...your_private_key_here

# Block Explorer (for verification)
ARC_EXPLORER_API_KEY=your_api_key_here
ARC_TESTNET_EXPLORER=https://explorer.testnet.arc.network
ARC_TESTNET_EXPLORER_API=https://api-explorer.testnet.arc.network

# Circle Faucet
# Get testnet USDC at: https://faucet.circle.com
# Select "Arc Testnet" and enter your wallet address

# Gas Reporting
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_cmc_api_key

# ICP Timer Configuration
ICP_TIMER_CANISTER_ID=your_canister_id
ICP_SIGNER_PUBLIC_KEY=your_icp_public_key_hex

# Contract Addresses (after deployment)
OUROC_PRIMA_ARC_ADDRESS=
USDC_ADDRESS=

# CCTP Configuration (for cross-chain)
CCTP_TOKEN_MESSENGER_ADDRESS=
CCTP_MESSAGE_TRANSMITTER_ADDRESS=
