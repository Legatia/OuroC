# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Aleph.im Configuration
ALEPH_API_URL=https://api2.aleph.im
ALEPH_CHANNEL=OuroC-Mesos

# Solana Account for Aleph Signing
# Generate a keypair for the backend to sign Aleph messages
# DO NOT use your personal wallet - create a dedicated backend keypair
# Format options:
#   1. Base58 string: "5JDrVj4FD3KKY..."
#   2. Byte array JSON: "[1,2,3,4,5,...]"
# Generate with: solana-keygen new --no-bip39-passphrase
SOLANA_PRIVATE_KEY=your_solana_private_key_here

# CORS Configuration
FRONTEND_URL=http://localhost:8085
