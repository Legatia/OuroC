# Backend Configuration (ICP Canisters)
# These are filled automatically after deployment

# Timer canister ID (handles subscriptions)
VITE_TIMER_CANISTER_ID=

# License registry canister ID (rate limiting)
VITE_LICENSE_CANISTER_ID=

# ICP Canister URL (for getting signatures)
VITE_ICP_CANISTER_URL=http://localhost:4943

# Solana Configuration

# Solana smart contract address (ouroc_prima)
VITE_SOLANA_CONTRACT=

# Solana RPC URL
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Network (devnet or mainnet-beta)
VITE_SOLANA_NETWORK=devnet

# Arc Configuration

# Arc smart contract address (OuroCPrimaArc)
VITE_ARC_CONTRACT=

# Arc USDC contract address
VITE_ARC_USDC_ADDRESS=

# Arc RPC URL
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network

# Arc Chain ID (check Arc docs for actual value)
VITE_ARC_CHAIN_ID=0

# Arc Explorer URL
VITE_ARC_EXPLORER_URL=https://explorer.testnet.arc.network

# License Configuration

# Enterprise license key for OuroC-Mesos
VITE_ENTERPRISE_LICENSE_KEY=ouro_enterprise_ouroc_mesos_2025
